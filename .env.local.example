# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# PayPal
# "sandbox" for testing, "live" for real payments
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# These are shown in the browser — use your sandbox/live Client ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Plan IDs — create these in PayPal Dashboard > Products & Subscriptions
NEXT_PUBLIC_PAYPAL_PLAN_ID_STARTER=P-your-starter-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO=P-your-pro-plan-id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
